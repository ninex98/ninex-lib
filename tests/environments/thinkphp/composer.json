{
    "name": "ninex-tests/thinkphp",
    "require": {
        "php": "^8.1",
        "ninex/lib": "^2.0@dev",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "topthink/framework": "^8.1",
        "topthink/think-orm": "^3.0 || ^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true,
                "versions": {
                    "ninex/lib": "2.0.x-dev"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Ninex\\Lib\\Core\\Tests\\": "../../Core/",
            "Ninex\\Lib\\ThinkPhp\\Tests\\": "../../ThinkPhp/",
            "Ninex\\Lib\\Examples\\ThinkPhp\\": "../../../examples/thinkphp/"
        }
    },
    "config": {
        "allow-plugins": false
    },
    "description": "Isolated thinkphp test application for ninex/lib (not published)",
    "license": "MIT",
    "type": "project"
}
