{
    "name": "ninex-tests/laravel",
    "require": {
        "php": "^8.1",
        "ninex/lib": "^2.0@dev",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true,
                "versions": {
                    "ninex/lib": "2.0.x-dev"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Ninex\\Lib\\Core\\Tests\\": "../../Core/",
            "Ninex\\Lib\\Tests\\": "../../Laravel/",
            "Ninex\\Lib\\Examples\\Laravel\\": "../../../examples/laravel/"
        }
    },
    "config": {
        "allow-plugins": false
    },
    "description": "Isolated laravel test application for ninex/lib (not published)",
    "license": "MIT",
    "type": "project"
}
