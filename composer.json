{
    "name": "ninex/lib",
    "description": "Framework-independent PHP CRUD core with optional Laravel and ThinkPHP integration",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ninex",
            "email": "hebeshare@163.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Ninex\\Lib\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ninex\\Lib\\Core\\Tests\\": "tests/Core/",
            "Ninex\\Lib\\Tests\\": "tests/Unit/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ninex\\Lib\\LibServiceProvider"
            ]
        },
        "think": {
            "services": [
                "Ninex\\Lib\\ThinkPhp\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php vendor/bin/pint --test src config tests/Core tests/Unit tests/Laravel tests/ThinkPhp examples tools bin",
        "format": "@php vendor/bin/pint src config tests/Core tests/Unit tests/Laravel tests/ThinkPhp examples tools bin",
        "build-package": "@php tools/build-package.php"
    },
    "suggest": {
        "laravel/framework": "Laravel 10–13 integration (use the PHP version required by your Laravel release).",
        "topthink/framework": "ThinkPHP 8.1 integration.",
        "topthink/think-orm": "ThinkORM 3 or 4 repository.",
        "guzzlehttp/guzzle": "Guzzle 7 HTTP client integration.",
        "ext-tokenizer": "Required by the CRUD generator for PHP syntax validation."
    },
    "bin": [
        "bin/ninex"
    ]
}
